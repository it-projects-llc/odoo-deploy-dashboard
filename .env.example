# Runtime data source: test = generic bundled fixtures; prod = authenticated live APIs.
# Values are case-sensitive. Defaults to test when omitted.
work_env=test
DASHBOARD_HOST=127.0.0.1
PORT=4173
DASHBOARD_ORIGIN=http://127.0.0.1:4173
DASHBOARD_POLL_SECONDS=15
DASHBOARD_CACHE_SECONDS=10
# Manual projects only: additional CI-only branches from the first 30 Forgejo entries.
# Tagged application projects list all branches with pagination.
DASHBOARD_DISCOVERY_LIMIT=8

# Required when work_env=prod. Forgejo base URL WITHOUT /api/v1.
FORGEJO_URL=https://forgejo.example.com
FORGEJO_TOKEN=
KOMODO_URL=https://komodo.example.com

# Production login: any enabled Komodo username/password account can sign in.
# No Authentik required. Generate a random secret: openssl rand -hex 32
# Sessions are encrypted HttpOnly cookies plus temporary in-memory session IDs.
DASHBOARD_AUTH_MODE=komodo
DASHBOARD_SESSION_SECRET=
# Number of trusted reverse proxy hops for login rate limiting. Keep 0 for direct access.
# Set 1 only when the listener is private behind exactly one trusted proxy.
DASHBOARD_TRUST_PROXY_HOPS=0

# Optional legacy proxy mode only (DASHBOARD_AUTH_MODE=proxy).
# Strip incoming x-dashboard-* headers, authenticate, and inject the user/secret.
DASHBOARD_PROXY_SECRET=
KOMODO_API_KEY=
KOMODO_API_SECRET=

# Discover all stacks visible to the Komodo account (default true).
# No per-stack configuration is required. Permissions are managed in Komodo.
DASHBOARD_AUTO_DISCOVER=true
# Optional explicit project grouping/application repository overrides.
# Leave empty for automatic discovery; use false above for manual-only mode.
DASHBOARD_PROJECTS_JSON='[]'

# Terminal uses the logged-in user JWT in komodo mode. No SSH configuration is needed.
DASHBOARD_TERMINAL_ENABLED=false
# Proxy mode uses KOMODO_API_KEY / KOMODO_API_SECRET for both reads and terminal.
# Comma-separated exact proxy identities allowed to use Shell.
DASHBOARD_TERMINAL_USERS=
# Production and unclassified targets require this switch; tagged staging/dev do not.
DASHBOARD_TERMINAL_PRODUCTION=false
DASHBOARD_TERMINAL_SHELL=/bin/bash
DASHBOARD_TERMINAL_MAX_CONNECTIONS=4
DASHBOARD_TERMINAL_IDLE_SECONDS=900
